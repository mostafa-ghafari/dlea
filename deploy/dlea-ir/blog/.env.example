# Copy to .env (kept out of git) and fill in.
# Generate strong passwords: openssl rand -base64 24
WP_DB_NAME=dlea_blog
WP_DB_USER=dlea_blog
WP_DB_PASSWORD=CHANGE_ME
WP_DB_ROOT_PASSWORD=CHANGE_ME_TOO
# Loopback port for the WordPress container (8080 is taken by meraat-prod).
WP_PORT=8090
WP_SITE_URL=https://blog.dlea.ir
