# E2E test build — points the client at the local Django backend.
# `npm run build -- --mode e2e` inlines these values.
# Uses 127.0.0.1 (not localhost) because on some machines `localhost`
# resolves to ::1 where the IPv4-only Django dev server does not listen.
VITE_API_URL=http://127.0.0.1:8000/api