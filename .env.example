# ============================================================================
# Dlea AI — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# Backend uses python-dotenv to load from backend/.env
# Frontend uses Vite's import.meta.env (prefixed with VITE_)

# ---------- Django Backend ----------

# Secret key for session signing and CSRF protection
# Generate a new one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me

# Set to "0" in production
DJANGO_DEBUG=1

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Database ----------

# Set to "1" to use SQLite (no Postgres needed)
# Leave unset or "0" to use PostgreSQL
USE_SQLITE=0

# PostgreSQL settings (used when USE_SQLITE is not "1")
POSTGRES_DB=dlea
POSTGRES_USER=dlea
POSTGRES_PASSWORD=dlea
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- CORS ----------

# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# ---------- Email (SMTP) ----------

# Leave EMAIL_HOST_USER empty to use Django's console email backend (dev mode)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=

# ---------- AI (Gemini) ----------

# Google AI Studio API key for the AI coach
GEMINI_API_KEY=

# Optional: override the default Gemini model
# GEMINI_MODEL=gemini-3.6-flash

# Optional: proxy URL for Gemini API (leave empty for direct calls)
# GEMINI_PROXY=

# ---------- Frontend (Vite) ----------

# API base URL for the React app (leave empty to auto-detect from window.location)
# VITE_API_URL=http://localhost:8002/api

# Google OAuth client ID for sign-up/login
VITE_GOOGLE_CLIENT_ID=
