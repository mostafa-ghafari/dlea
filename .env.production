# Production environment — set these during deployment
#
# Same-origin on purpose: the bundle asks whichever host served it for `/api`,
# and every nginx vhost proxies that path to the backend. An absolute URL here
# pinned every visitor — and, before WEBHOOK_URL was set, the MetaTrader webhook
# address the backend echoed back — to whatever host the bundle was built with.
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=604447884984-9bl6a66i13r5jcroovkdabsidttgnpel.apps.googleusercontent.com
