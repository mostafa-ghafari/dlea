# ── Django Backend (Docker) ────────────────────────────────────────

# Secret key — CHANGE THIS IN REAL DEPLOYMENTS
DJANGO_SECRET_KEY=django-insecure-dlea-prod-change-me-in-real-deploy

# Production mode
DJANGO_DEBUG=0

# Allowed hosts
DJANGO_ALLOWED_HOSTS=dlea.piqagram.ir,localhost,backend

# ── Database (Docker service name: db) ────────────────────────────
POSTGRES_DB=dlea
POSTGRES_USER=dlea
POSTGRES_PASSWORD=dlea
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://dlea.piqagram.ir,http://localhost:3000

# ── Email (SMTP) ─────────────────────────────────────────────────
EMAIL_HOST_USER=farvimail@gmail.com
EMAIL_HOST_PASSWORD=YOUR_APP_PASSWORD_HERE
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1

# ── AI (Gemini) ──────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
