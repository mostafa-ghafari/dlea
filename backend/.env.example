# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
# Google answers requests from Iranian IPs with an HTML 403 page that never
# reaches the API. Point this at a relay that takes the whole Google URL as its
# path (see deploy/gemini-relay-worker.js), or leave it empty to call Google
# directly. Several bases separated by commas are tried in order.
GEMINI_PROXY=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (SMTP)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Dlea AI <your_email@gmail.com>

# Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate_a_strong_secret_key
DJANGO_ALLOWED_HOSTS=dlea.piqagram.ir

# PostgreSQL
POSTGRES_DB=dlea
POSTGRES_USER=dlea
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=https://dlea.piqagram.ir

# Payment gateway (Zibal). The literal `zibal` merchant is the gateway's
# public test merchant: without your own merchant code every payment is fake.
ZIBAL_MERCHANT=your_zibal_merchant_code
# The public address the gateway sends the buyer back to. Leave it empty to
# use the incoming request host; set it in production, because the CDN
# terminates TLS and the origin would otherwise advertise an http:// callback.
PUBLIC_BACKEND_URL=https://dlea.piqagram.ir
# Where the buyer lands after the bank: the billing page.
FRONTEND_URL=https://dlea.piqagram.ir
